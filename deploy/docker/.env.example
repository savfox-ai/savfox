# Savfox Gateway Docker Configuration
SAVFOX_PORT=18881
SAVFOX_TOKEN=your-secret-token-here
RUST_LOG=info

# Provider API Keys (set the ones you need)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

# Optional reverse proxy / TLS
SAVFOX_DOMAIN=example.com
SAVFOX_TLS_EMAIL=ops@example.com

# Optional backing stores
REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://savfox:savfox@postgres:5432/savfox

# Resource limits
GATEWAY_CPU_LIMIT=1.0
GATEWAY_MEM_LIMIT=1g
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
