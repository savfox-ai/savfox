<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.savfox.gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/savfox</string>
        <string>gateway</string>
        <string>--port</string>
        <string>18881</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SAVFOX_HOME</key>
        <string>/Users/USER/.savfox</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/savfox-gateway.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/savfox-gateway.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/USER</string>
</dict>
</plist>
