# Core gateway
SAVFOX_PORT=18881
SAVFOX_TOKEN=replace-with-strong-secret
RUST_LOG=info

# Optional provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional backing services
REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://savfox:replace-with-strong-password@postgres:5432/savfox
POSTGRES_USER=savfox
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=savfox

# Optional proxy / TLS
SAVFOX_DOMAIN=example.com
SAVFOX_TLS_EMAIL=ops@example.com

# Resource limits
GATEWAY_CPU_LIMIT=1.0
GATEWAY_MEM_LIMIT=1g
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512m
POSTGRES_CPU_LIMIT=0.75
POSTGRES_MEM_LIMIT=1g
PROXY_CPU_LIMIT=0.5
PROXY_MEM_LIMIT=512m

# Log rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
